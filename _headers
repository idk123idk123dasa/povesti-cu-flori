/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *

/pages/*
  Cache-Control: no-cache, no-store, must-revalidate

/products/*
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable, no-transform
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable, no-transform
/assets/*.gif
  Cache-Control: public, max-age=31536000, immutable, no-transform
/assets/*.mp4
  Cache-Control: public, max-age=31536000, immutable, no-transform
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable, no-transform
